<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.uclouvain.visualsearchtree.tree.NQueensInputController">
    <Label text="Enter the number of queens (N):" style="-fx-font-size: 14px;"/>
    <TextField fx:id="nQueensInput" promptText="e.g., 8" onAction="#submit"/>
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="submitButton" text="Submit" onAction="#submit" defaultButton="true"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#cancel"/>
    </HBox>
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;"/>
</VBox>